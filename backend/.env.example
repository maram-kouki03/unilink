# PostgreSQL connection string of the Supabase database
# (Supabase dashboard → Connect → "Session pooler" URI, works on IPv4 networks)
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Long random string used to sign login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Local port only. On Render, PORT is set automatically: do not add it there.
PORT=4000
ALLOWED_EMAIL_DOMAIN=supcom.tn

# Cloudinary (file storage for documents and photos).
# Cloudinary dashboard → Settings → API Keys (or the "Product Environment" card on the home page).
# Never commit the real values.
CLOUDINARY_CLOUD_NAME=YOUR-CLOUD-NAME
CLOUDINARY_API_KEY=YOUR-API-KEY
CLOUDINARY_API_SECRET=YOUR-API-SECRET
