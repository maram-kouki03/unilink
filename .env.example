# Copy to .env and fill in.

# Address of the Unilink backend (backend/). On a phone with Expo Go use your PC's
# Wi-Fi IPv4 address (run `ipconfig` in PowerShell), NOT localhost.
EXPO_PUBLIC_API_URL=http://<PC IPv4>:4000

# Only e-mails from this domain can create an account (also enforced by the backend)
EXPO_PUBLIC_ALLOWED_EMAIL_DOMAIN=supcom.tn
